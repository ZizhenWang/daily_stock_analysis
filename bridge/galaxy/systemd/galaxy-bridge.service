[Unit]
Description=Galaxy AmazingData Bridge
After=network.target

[Service]
Type=simple
User=stock
Group=stock
WorkingDirectory=/opt/stock-analyzer/daily_stock_analysis
EnvironmentFile=/opt/stock-analyzer/daily_stock_analysis/bridge/galaxy/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc '/opt/stock-analyzer/daily_stock_analysis/.venv-galaxy-bridge/bin/uvicorn bridge.galaxy.app:app --host "$GALAXY_BRIDGE_HOST" --port "$GALAXY_BRIDGE_PORT"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
